# =============================================================================
# Contoh konfigurasi StockMate API.
# Salin nilai ke environment variable atau secret manager.
# JANGAN commit file .env yang berisi nilai asli.
# =============================================================================

# Wajib: connection string PostgreSQL.
# Ganti <password-anda> dengan password yang dibuat sendiri.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=stockmate;Username=stockmate_app;Password=<password-anda>

# Wajib untuk Production: minimal 32 karakter acak.
# Di Development, bila kosong, API memakai key ephemeral in-memory.
Jwt__SigningKey=<minimal-32-karakter-acak>

Jwt__Issuer=StockMate.Api
Jwt__Audience=StockMate.Clients
Jwt__ExpiryMinutes=120

# Origin web yang diizinkan. Tambahkan indeks berikutnya bila perlu.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://127.0.0.1:5173

# Opsional: jalankan schema saat API start (default false).
Database__AutoMigrate=false

# Opsional: aktifkan Swagger di luar Development (default false).
Swagger__Enabled=false

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5131
